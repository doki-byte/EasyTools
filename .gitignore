# 依赖与依赖目录
frontend/node_modules/
frontend/dist/*
!frontend/dist/gitkeep

# 构建产物
build/bin/
EasyTools.exe
EasyTools
*.dmg
*.tar.gz
*.zip

# 运行期数据（配置库、日志、字典、生成的载荷等）
