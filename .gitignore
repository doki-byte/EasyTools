.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
*.tmp
*.bak

# 本地环境配置
.env
.env.*
local.env

# 加密/签名材料（避免误提交）
*.pfx
*.p12
*.pem
*.key
